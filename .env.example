# Everything is optional; `docker compose up` works without a .env file.

# URL your phone uses to reach the API, e.g. http://192.168.1.10:3000
BETTER_AUTH_URL=http://localhost:3000
API_PORT=3000

# Change before exposing the server beyond your home network
POSTGRES_PASSWORD=foodtools

# Leave empty to have one generated and stored in the api-data volume
BETTER_AUTH_SECRET=

# Comma-separated extra origins allowed to call the API (e.g. a hosted web build)
TRUSTED_ORIGINS=

# Optional: lets recipe import fall back to Claude for web pages and text it can't read
# itself. Create a key at https://platform.claude.com/. Only the recipe text is sent, and
# a recipe costs a fraction of a penny. Leave empty to keep this switched off.
ANTHROPIC_API_KEY=

# Only used by `npm run dev` in apps/api (Postgres from compose.dev.yml)
DATABASE_URL=postgres://foodtools:foodtools@localhost:5432/foodtools

# Set to true once your accounts exist, so nobody else can register
DISABLE_SIGNUP=false
